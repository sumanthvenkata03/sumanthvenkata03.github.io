{
  "name": "sumanthvenkata-portfolio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Sumanth Venkata portfolio — React 19 + Redux Toolkit + TypeScript (Vite)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node verification/postbuild.mjs",
    "prerender": "node verification/prerender.mjs",
    "build:static": "npm run build && npm run prerender",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "capture:baseline": "tsx verification/capture-baseline.ts",
    "verify": "tsx verification/verify.ts",
    "verify:contact": "node verification/contact.mjs",
    "check:seo": "node verification/check-seo.mjs"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.5.0",
    "framer-motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "pixelmatch": "^6.0.0",
    "playwright": "^1.50.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0"
  }
}
